    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^6.0.0"
  },
  "description": "Independent Rescue 1122 website redesign built with React, Vite, and accessible browser interactions",
  "engines": {
    "node": ">=22.13.0"
  },
